# Copy to .env locally and set actual credentials only on the server/local machine.
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
SMS_GATEWAY_API_KEY=replace-with-SMS.NET.BD-account-api-key
# Use only a Sender ID approved by SMS.NET.BD.
SMS_GATEWAY_SENDER_ID=
# Multi-recipient campaigns require an approved content ID.
SMS_GATEWAY_CONTENT_ID=
HTTPSMS_API_KEY=
HTTPSMS_PHONE_NUMBER=+8801XXXXXXXXX
HTTPSMS_WEBHOOK_SIGNING_KEY=
